{
  "name": "@nodeaccess/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "APP_MODE=api tsx watch src/server.ts",
    "dev:gateway": "APP_MODE=gateway tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "config:sync-env": "node scripts/sync-env-to-db.mjs",
    "platform:promote-admin": "node scripts/promote-platform-admin.mjs"
  },
  "dependencies": {
    "@1password/sdk": "^0.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^10.0.1",
    "@nodeaccess/shared": "*",
    "@prisma/client": "^5.13.0",
    "bcrypt": "^5.1.1",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pino": "^9.1.0",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.15.0",
    "zod": "^3.23.4",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/ssh2": "^1.11.19",
    "dotenv": "^16.4.5",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.13.0",
    "tsx": "^4.9.3"
  }
}
