    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/ssh2": "^1.11.19",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.9.3"
