    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/websocket": "11.3.3",
    "@nodeaccess/shared": "*",
    "@prisma/client": "6.19.3",
    "@xterm/headless": "5.5.0",
    "bcrypt": "6.0.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^8.2.0",
    "nodemailer": "10.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pino": "^9.1.0",
