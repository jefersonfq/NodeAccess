{
  "name": "@nodeaccess/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs api",
    "dev:gateway": "node scripts/dev.mjs gateway",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "config:sync-env": "node scripts/sync-env-to-db.mjs",
    "platform:create-superadmin": "node scripts/create-superadmin.mjs",
    "platform:promote-admin": "node scripts/promote-platform-admin.mjs",
    "admin:recover": "node scripts/recover-admin-access.mjs",
    "crypto:inventory": "tsx scripts/encryption-inventory.ts",
    "crypto:rewrap-vault-secrets": "tsx scripts/vault-secret-rewrap.ts",
