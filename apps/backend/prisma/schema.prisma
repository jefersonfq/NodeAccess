  id                 Int                  @id @default(autoincrement())
  tenantId           Int                  @map("tenant_id")
  userId             Int                  @map("user_id")
  forwardingId       Int?                 @map("forwarding_id")
  hostId             Int?                 @map("host_id")
  eventType          LocalAccessEventType @map("event_type")
  labelSnapshot      String?              @map("label_snapshot") @db.VarChar(255)
  hostNameSnapshot   String?              @map("host_name_snapshot") @db.VarChar(255)
  remoteHostSnapshot String               @map("remote_host_snapshot") @db.VarChar(255)
  remotePortSnapshot Int                  @map("remote_port_snapshot")
  localPortSnapshot  Int?                 @map("local_port_snapshot")
  usedPortFallback   Boolean?             @map("used_port_fallback")
  occurredAt         DateTime             @default(now()) @map("occurred_at")
  metadataJson       Json?                @map("metadata_json")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  forwarding PortForwarding? @relation(fields: [forwardingId], references: [id], onDelete: SetNull)
  host       Host?           @relation(fields: [hostId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt], map: "local_access_events_tenant_occurred_idx")
  @@index([tenantId, userId, occurredAt], map: "local_access_events_tenant_user_occurred_idx")
  @@index([tenantId, forwardingId, occurredAt], map: "local_access_events_tenant_forwarding_occurred_idx")
  @@index([tenantId, hostId, occurredAt], map: "local_access_events_tenant_host_occurred_idx")
  @@index([tenantId, eventType, occurredAt], map: "local_access_events_tenant_type_occurred_idx")
  @@map("local_access_events")
}

// ---------------------------------------------------------------------------
// Webhooks
// ---------------------------------------------------------------------------

enum WebhookSubscriptionStatus {
  ACTIVE
  PAUSED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRY_SCHEDULED
  DEAD
}

enum WebhookPayloadMode {
  AUTOMATIC
  CUSTOM
}

enum InboundWebhookEndpointStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum InboundWebhookMappingMode {
  GENERIC
  PROVIDER_ADAPTER
}

enum InboundWebhookReceiptStatus {
  RECEIVED
  ACCEPTED
  REJECTED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model WebhookSubscription {
  id                   Int                       @id @default(autoincrement())
  tenantId             Int                       @map("tenant_id")
  name                 String                    @db.VarChar(120)
  description          String?                   @db.Text
  targetUrl            String                    @map("target_url") @db.VarChar(2048)
  httpMethod           String                    @default("POST") @map("http_method") @db.VarChar(10)
  status               WebhookSubscriptionStatus @default(ACTIVE)
  subscribedEventsJson String                    @map("subscribed_events_json") @db.Text
  secretEncrypted      String?                   @map("secret_encrypted") @db.Text
  secretIv             String?                   @map("secret_iv") @db.VarChar(64)
  headersJson          String?                   @map("headers_json") @db.Text
  payloadMode          WebhookPayloadMode        @default(AUTOMATIC) @map("payload_mode")
  payloadTemplateJson  String?                   @map("payload_template_json") @db.Text
  payloadSchemaJson    String?                   @map("payload_schema_json") @db.Text
  timeoutMs            Int                       @default(5000) @map("timeout_ms")
  maxRetries           Int                       @default(5) @map("max_retries")
  lastTriggeredAt      DateTime?                 @map("last_triggered_at")
  lastSuccessAt        DateTime?                 @map("last_success_at")
  lastFailureAt        DateTime?                 @map("last_failure_at")
  createdByUserId      Int                       @map("created_by_user_id")
  updatedByUserId      Int?                      @map("updated_by_user_id")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  createdBy  User              @relation("WebhookSubscriptionCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy  User?             @relation("WebhookSubscriptionUpdatedBy", fields: [updatedByUserId], references: [id])
  deliveries WebhookDelivery[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id                  Int                   @id @default(autoincrement())
  subscriptionId      Int                   @map("subscription_id")
  tenantId            Int                   @map("tenant_id")
  eventId             String                @map("event_id") @db.VarChar(64)
  eventType           String                @map("event_type") @db.VarChar(100)
  eventVersion        Int                   @map("event_version")
  resourceType        String                @map("resource_type") @db.VarChar(60)
  resourceId          String                @map("resource_id") @db.VarChar(64)
  status              WebhookDeliveryStatus @default(PENDING)
  payloadJson         String                @map("payload_json") @db.LongText
  idempotencyKey      String                @map("idempotency_key") @db.VarChar(128)
  attemptCount        Int                   @default(0) @map("attempt_count")
  nextAttemptAt       DateTime?             @map("next_attempt_at")
  lastAttemptAt       DateTime?             @map("last_attempt_at")
  responseStatus      Int?                  @map("response_status")
  responseLatencyMs   Int?                  @map("response_latency_ms")
  responseBodySnippet String?               @map("response_body_snippet") @db.VarChar(512)
  lastErrorCode       String?               @map("last_error_code") @db.VarChar(64)
  lastErrorMessage    String?               @map("last_error_message") @db.VarChar(512)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, subscriptionId, status, createdAt], map: "webhook_deliv_tenant_sub_status_time_idx")
  @@map("webhook_deliveries")
}

model EmailConfig {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @unique @map("tenant_id")
  provider    String   @db.VarChar(20)
  host        String?  @db.VarChar(255)
  port        Int?
  secure      Boolean  @default(false)
  user        String   @db.VarChar(255)
  passwordEnc String   @map("password_enc") @db.Text
  passwordIv  String   @map("password_iv") @db.VarChar(64)
  fromName    String   @map("from_name") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("email_configs")
}

model WebhookEventOutbox {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  eventType        String    @map("event_type") @db.VarChar(100)
  eventVersion     Int       @default(1) @map("event_version")
  resourceType     String    @map("resource_type") @db.VarChar(60)
  resourceId       String    @map("resource_id") @db.VarChar(64)
  eventPayloadJson String    @map("event_payload_json") @db.LongText
  occurredAt       DateTime  @map("occurred_at")
  correlationId    String?   @map("correlation_id") @db.VarChar(64)
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([processedAt, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@map("webhook_event_outbox")
}

model InboundWebhookEndpoint {
  id                    Int                          @id @default(autoincrement())
  tenantId              Int                          @map("tenant_id")
  provider              String                       @db.VarChar(60)
  name                  String                       @db.VarChar(120)
  description           String?                      @db.Text
  endpointTokenHash     String                       @unique(map: "inwh_endpoints_token_hash_key") @map("endpoint_token_hash") @db.VarChar(128)
  secretEncrypted       String?                      @map("secret_encrypted") @db.Text
  secretIv              String?                      @map("secret_iv") @db.VarChar(64)
  status                InboundWebhookEndpointStatus @default(ACTIVE)
  allowedEventTypesJson String                       @map("allowed_event_types_json") @db.Text
  mappingMode           InboundWebhookMappingMode    @default(GENERIC) @map("mapping_mode")
  createdByUserId       Int                          @map("created_by_user_id")
  updatedByUserId       Int?                         @map("updated_by_user_id")
  lastReceivedAt        DateTime?                    @map("last_received_at")
  lastAcceptedAt        DateTime?                    @map("last_accepted_at")
  lastRejectedAt        DateTime?                    @map("last_rejected_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User                    @relation("InboundWebhookEndpointCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User?                   @relation("InboundWebhookEndpointUpdatedBy", fields: [updatedByUserId], references: [id])
  receipts  InboundWebhookReceipt[]

  @@index([tenantId, status], map: "inwh_endpoints_tenant_status_idx")
  @@index([tenantId, provider], map: "inwh_endpoints_tenant_provider_idx")
  @@index([tenantId, createdAt], map: "inwh_endpoints_tenant_created_idx")
  @@map("inbound_webhook_endpoints")
}

model InboundWebhookReceipt {
  id                  Int                         @id @default(autoincrement())
  tenantId            Int                         @map("tenant_id")
  endpointId          Int                         @map("endpoint_id")
  provider            String                      @db.VarChar(60)
  externalEventId     String?                     @map("external_event_id") @db.VarChar(128)
  eventType           String                      @map("event_type") @db.VarChar(120)
  idempotencyKey      String?                     @map("idempotency_key") @db.VarChar(160)
  status              InboundWebhookReceiptStatus @default(RECEIVED)
  receivedAt          DateTime                    @default(now()) @map("received_at")
  processedAt         DateTime?                   @map("processed_at")
  sourceIp            String?                     @map("source_ip") @db.VarChar(64)
  signatureValid      Boolean                     @default(false) @map("signature_valid")
  payloadHash         String                      @map("payload_hash") @db.VarChar(128)
  payloadJson         String                      @map("payload_json") @db.LongText
  normalizedEventJson String?                     @map("normalized_event_json") @db.LongText
  errorCode           String?                     @map("error_code") @db.VarChar(64)
  errorMessage        String?                     @map("error_message") @db.VarChar(512)
  correlationId       String?                     @map("correlation_id") @db.VarChar(128)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint InboundWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, idempotencyKey], map: "inwh_receipts_endpoint_idem_key")
  @@index([tenantId, endpointId, receivedAt], map: "inwh_receipts_tenant_endpoint_received_idx")
  @@index([tenantId, status, receivedAt], map: "inwh_receipts_tenant_status_received_idx")
  @@index([tenantId, provider, externalEventId], map: "inwh_receipts_tenant_provider_event_idx")
  @@map("inbound_webhook_receipts")
}
