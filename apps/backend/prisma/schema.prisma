generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant
// ---------------------------------------------------------------------------

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                      User[]
  groups                     Group[]
  hosts                      Host[]
  folders                    Folder[]
  hostPersonalFolders        HostPersonalFolder[]
  inventoryNodes             InventoryNode[]             @relation("InventoryNodes")
  inventoryRoot              InventoryNode?              @relation("InventoryRoot")
  resourceAclEntries         ResourceAclEntry[]
  license                    License?
  sessionAuditPolicy         SessionAuditPolicy?
  authPolicy                 TenantAuthPolicy?
  externalIdentities         ExternalIdentity[]
  emailConfig                EmailConfig?
  snippets                   Snippet[]
  snippetGroups              SnippetGroup[]
  snippetExecutionEvents     SnippetExecutionEvent[]
  secrets                    Secret[]
  agents                     Agent[]
  mcpTokens                  McpToken[]
  feedbacks                  Feedback[]
  localAiKnowledgeDocuments  LocalAiKnowledgeDocument[]
  localAiProposedActions     LocalAiProposedAction[]
  hostLinks                  HostLink[]
  associatedLinks            HostAssociatedLink[]
  sharedSessions             SharedSession[]
  aiSshActionCommandPolicy   AiSshActionCommandPolicy?
  sessionCommandPolicyGroups SessionCommandPolicyGroup[]
  mcpInteractiveSshSessions  McpInteractiveSshSession[]
  webhookSubscriptions       WebhookSubscription[]
  inboundWebhookEndpoints    InboundWebhookEndpoint[]
  inboundWebhookReceipts     InboundWebhookReceipt[]
  nativeSshGatewayConfig     NativeSshGatewayConfig?
  bastionHosts               BastionHost[]
  hostBulkActionHistories    HostBulkActionHistory[]
  localAccessEvents          LocalAccessEvent[]
  haNodes                    HaNode[]
  haOperations               HaOperation[]
  haAgentJobs                HaAgentJob[]

  @@map("tenants")
}

model TenantAuthPolicy {
  id                               Int      @id @default(autoincrement())
  tenantId                         Int      @unique @map("tenant_id")
  localLoginEnabled                Boolean  @default(true) @map("local_login_enabled")
  ssoRequired                      Boolean  @default(false) @map("sso_required")
  mfaRequired                      Boolean  @default(true) @map("mfa_required")
  jitProvisioningEnabled           Boolean  @default(false) @map("jit_provisioning_enabled")
  automaticAccountLinkingEnabled   Boolean  @default(false) @map("automatic_account_linking_enabled")
  emailTenantDiscoveryEnabled      Boolean  @default(true) @map("email_tenant_discovery_enabled")
  lockoutMaxAttempts               Int?     @map("lockout_max_attempts")
  lockoutDurationMinutes           Int?     @map("lockout_duration_minutes")
  accessTokenMinutes               Int?     @map("access_token_minutes")
  refreshTokenDays                 Int?     @map("refresh_token_days")
  breakGlassUserId                 Int?     @map("break_glass_user_id")
  breakGlassValidatedAt            DateTime? @map("break_glass_validated_at")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  breakGlassUser User? @relation("TenantAuthPolicyBreakGlassUser", fields: [breakGlassUserId], references: [id], onDelete: SetNull)

  @@index([breakGlassUserId])
  @@map("tenant_auth_policies")
}

model ExternalIdentity {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  userId      Int      @map("user_id")
  providerKey String   @map("provider_key") @db.VarChar(80)
  issuer      String   @db.VarChar(500)
  issuerHash  String   @map("issuer_hash") @db.Char(64)
  subject     String   @db.VarChar(500)
  subjectHash String   @map("subject_hash") @db.Char(64)
  emailAtLink String?  @map("email_at_link") @db.VarChar(320)
  active      Boolean  @default(true)
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, issuerHash, subjectHash])
  @@unique([tenantId, providerKey, userId])
  @@index([userId])
  @@index([tenantId, active])
  @@map("external_identities")
}

model NativeSshGatewayConfig {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @unique @map("tenant_id")
  enabled        Boolean  @default(false)
  bindHost       String   @default("0.0.0.0") @map("bind_host") @db.VarChar(255)
  port           Int      @default(2222)
  publicEndpoint String?  @map("public_endpoint") @db.VarChar(255)
  hostKeyPath    String?  @map("host_key_path") @db.VarChar(1000)
  passwordAuth   Boolean  @default(true) @map("password_auth")
  mfaRequired    Boolean  @default(true) @map("mfa_required")
  publicKeyAuth  Boolean  @default(false) @map("public_key_auth")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operations HaOperation[]

  @@map("native_ssh_gateway_configs")
}

// ---------------------------------------------------------------------------
// Usuários
// ---------------------------------------------------------------------------

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String
  passwordHash        String?   @map("password_hash")
  role                Role      @default(USER)
  isPlatformAdmin     Boolean   @default(false) @map("is_platform_admin")
  mfaSecret           String?   @map("mfa_secret")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  active              Boolean   @default(true)
  canManageHosts      Boolean   @default(false) @map("can_manage_hosts")
  canViewLiveSessions Boolean   @default(false) @map("can_view_live_sessions")
  licenseConsumed     Boolean   @default(true) @map("license_consumed")
  forcePasswordChange Boolean   @default(true) @map("force_password_change")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  sessionVersion      Int       @default(0) @map("session_version")
  googleId            String?   @unique @map("google_id")
  preferencesJson     Json?     @map("preferences_json")
  avatarMimeType      String?   @map("avatar_mime_type") @db.VarChar(64)
  avatarUpdatedAt     DateTime? @map("avatar_updated_at")
  tenantId            Int       @map("tenant_id")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant                            Tenant                      @relation(fields: [tenantId], references: [id])
  groups                            UserGroup[]
  ownedHosts                        Host[]                      @relation("HostOwner")
  hostPersonalFolders               HostPersonalFolder[]
  pemKeys                           PemKey[]
  sessions                          Session[]
  sessionAudits                     SessionAudit[]
  sessionAuditPolicies              SessionAuditPolicyUser[]
  authLogs                          AuthLog[]
  externalIdentities                ExternalIdentity[]
  breakGlassAuthPolicies            TenantAuthPolicy[]          @relation("TenantAuthPolicyBreakGlassUser")
  adminLogs                         AdminLog[]
  folders                           Folder[]
  snippets                          Snippet[]
  snippetGroups                     SnippetGroup[]              @relation("SnippetGroupCreatedBy")
  snippetExecutionEvents            SnippetExecutionEvent[]
  ownedSecrets                      Secret[]                    @relation("SecretOwner")
  createdSecrets                    Secret[]                    @relation("SecretCreator")
  agents                            Agent[]                     @relation("AgentCreatedBy")
  revokedAgents                     Agent[]                     @relation("AgentRevokedBy")
  deletedAgents                     Agent[]                     @relation("AgentDeletedBy")
  createdMcpTokens                  McpToken[]                  @relation("McpTokenCreatedBy")
  revokedMcpTokens                  McpToken[]                  @relation("McpTokenRevokedBy")
  feedbacks                         Feedback[]
  localAiKnowledgeDocuments         LocalAiKnowledgeDocument[]  @relation("LocalAiKnowledgeDocumentCreator")
  requestedLocalAiProposedActions   LocalAiProposedAction[]     @relation("LocalAiProposedActionRequester")
  reviewedLocalAiProposedActions    LocalAiProposedAction[]     @relation("LocalAiProposedActionReviewer")
  deletedFeedbacks                  Feedback[]                  @relation("FeedbackDeletedBy")
  createdHostLinks                  HostLink[]                  @relation("HostLinkCreator")
  ownedSharedSessions               SharedSession[]             @relation("SharedSessionOwner")
  sharedSessionParticipations       SharedSessionParticipant[]
  grantedSharedSessionControlLeases SharedSessionControlLease[] @relation("SharedSessionControlLeaseGrantor")
  controlledSharedSessionLeases     SharedSessionControlLease[] @relation("SharedSessionControlLeaseController")
  mcpInteractiveSshSessions         McpInteractiveSshSession[]
  createdInventoryNodes             InventoryNode[]             @relation("InventoryNodeCreator")
  updatedInventoryNodes             InventoryNode[]             @relation("InventoryNodeUpdater")
  createdResourceAclEntries         ResourceAclEntry[]          @relation("ResourceAclEntryCreator")
  createdWebhookSubscriptions       WebhookSubscription[]       @relation("WebhookSubscriptionCreatedBy")
  updatedWebhookSubscriptions       WebhookSubscription[]       @relation("WebhookSubscriptionUpdatedBy")
  createdInboundWebhookEndpoints    InboundWebhookEndpoint[]    @relation("InboundWebhookEndpointCreatedBy")
  updatedInboundWebhookEndpoints    InboundWebhookEndpoint[]    @relation("InboundWebhookEndpointUpdatedBy")
  hostBulkActionHistories           HostBulkActionHistory[]     @relation("HostBulkActionHistoryActor")
  localAccessEvents                 LocalAccessEvent[]

  @@index([tenantId, active, licenseConsumed])
  @@index([tenantId, createdAt])
  @@index([email, tenantId])
  @@index([tenantId, deletedAt])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

enum FeedbackType {
  SUGGESTION
  PROBLEM
  QUESTION
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  NOT_PLANNED
  COMPLETED
}

enum LocalAiKnowledgeSourceType {
  TEXT
  LINK
  FILE
}

enum LocalAiKnowledgeStatus {
  READY
  FAILED
}

enum LocalAiProposedActionType {
  TEST_HOST_CONNECTION
}

enum LocalAiProposedActionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Grupos
// ---------------------------------------------------------------------------

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  bastionId   Int?     @map("bastion_id")
  tenantId    Int      @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  bastion              BastionHost?              @relation(fields: [bastionId], references: [id])
  users                UserGroup[]
  hosts                Host[]
  secrets              Secret[]
  sessionAuditPolicies SessionAuditPolicyGroup[]

  @@index([tenantId, name], map: "groups_tenant_name_idx")
  @@map("groups")
}

model UserGroup {
  userId    Int      @map("user_id")
  groupId   Int      @map("group_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId, userId], map: "user_groups_group_user_idx")
  @@map("user_groups")
}

// ---------------------------------------------------------------------------
// Hosts
// ---------------------------------------------------------------------------

model Host {
  id                        Int                 @id @default(autoincrement())
  name                      String
  description               String?             @db.VarChar(1000)
  ip                        String
  port                      Int                 @default(22)
  accessProtocol            HostAccessProtocol  @default(SSH) @map("access_protocol")
  operatingSystem           HostOperatingSystem @default(UNKNOWN) @map("operating_system")
  sshUser                   String              @map("ssh_user")
  authType                  AuthType            @map("auth_type")
  connectionMode            HostConnectionMode  @default(DIRECT) @map("connection_mode")
  privateAccessConnectorId  Int?                @map("private_access_connector_id")
  pemKeyId                  Int?                @map("pem_key_id")
  passwordEncrypted         String?             @map("password_encrypted") @db.Text
  scope                     HostScope
  ownerId                   Int?                @map("owner_id")
  groupId                   Int?                @map("group_id")
  folderId                  Int?                @map("folder_id")
  bastionId                 Int?                @map("bastion_id")
  onePasswordRef            String?             @map("one_password_ref")
  startupSnippetId          Int?                @map("startup_snippet_id")
  startupSnippetMode        String              @default("DISABLED") @map("startup_snippet_mode") @db.VarChar(16)
  trustedHostKeyFingerprint String?             @map("trusted_host_key_fingerprint")
  trustedHostKeyVerifiedAt  DateTime?           @map("trusted_host_key_verified_at")
  trustedHostKeyVerifiedBy  Int?                @map("trusted_host_key_verified_by")
  tenantId                  Int                 @map("tenant_id")
  deletedAt                 DateTime?           @map("deleted_at")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  owner                     User?                      @relation("HostOwner", fields: [ownerId], references: [id])
  group                     Group?                     @relation(fields: [groupId], references: [id])
  folder                    Folder?                    @relation(fields: [folderId], references: [id])
  personalFolders           HostPersonalFolder[]
  bastion                   BastionHost?               @relation(fields: [bastionId], references: [id])
  pemKey                    PemKey?                    @relation(fields: [pemKeyId], references: [id])
  sessions                  Session[]
  sessionAudits             SessionAudit[]
  snippetExecutionEvents    SnippetExecutionEvent[]
  tags                      HostTag[]
  portForwardings           PortForwarding[]
  localAccessEvents         LocalAccessEvent[]
  hostLinks                 HostLink[]
  associatedLinks           HostAssociatedLink[]
  sharedSessions            SharedSession[]
  mcpInteractiveSshSessions McpInteractiveSshSession[]
  inventoryNode             InventoryNode?

  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@index([tenantId, ip])
  @@index([tenantId, deletedAt, name], map: "hosts_tenant_deleted_name_idx")
  @@index([tenantId, deletedAt, accessProtocol, name], map: "hosts_tenant_deleted_protocol_name_idx")
  @@index([tenantId, deletedAt, scope, name])
  @@index([tenantId, deletedAt, groupId, name])
  @@index([tenantId, deletedAt, folderId, name])
  @@index([tenantId, deletedAt, ownerId, name])
  @@index([tenantId, privateAccessConnectorId], map: "hosts_private_access_connector_idx")
  @@map("hosts")
}

model Feedback {
  id              Int            @id @default(autoincrement())
  tenantId        Int            @map("tenant_id")
  userId          Int            @map("user_id")
  type            FeedbackType
  title           String
  message         String         @db.Text
  status          FeedbackStatus @default(NEW)
  adminResponse   String?        @map("admin_response") @db.Text
  contextRoute    String?        @map("context_route")
  contextScreen   String?        @map("context_screen")
  closedAt        DateTime?      @map("closed_at")
  deletedAt       DateTime?      @map("deleted_at")
  deletedByUserId Int?           @map("deleted_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User?  @relation("FeedbackDeletedBy", fields: [deletedByUserId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@index([deletedByUserId])
  @@map("feedbacks")
}

model LocalAiKnowledgeDocument {
  id              Int                        @id @default(autoincrement())
  tenantId        Int                        @map("tenant_id")
  createdByUserId Int                        @map("created_by_user_id")
  sourceType      LocalAiKnowledgeSourceType @map("source_type")
  status          LocalAiKnowledgeStatus     @default(READY)
  title           String
  description     String?                    @db.Text
  referenceUrl    String?                    @map("reference_url") @db.Text
  fileName        String?                    @map("file_name")
  mimeType        String?                    @map("mime_type")
  byteSize        Int?                       @map("byte_size")
  contentText     String?                    @map("content_text") @db.LongText
  errorMessage    String?                    @map("error_message") @db.Text
  deletedAt       DateTime?                  @map("deleted_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_lai_kb_doc_tenant")
  createdBy User   @relation("LocalAiKnowledgeDocumentCreator", fields: [createdByUserId], references: [id], onDelete: Cascade, map: "fk_lai_kb_doc_user")

  @@index([tenantId, status, createdAt], map: "idx_lai_kb_tenant_status_created")
  @@index([tenantId, sourceType, createdAt], map: "idx_lai_kb_tenant_source_created")
  @@index([createdByUserId, createdAt], map: "idx_lai_kb_user_created")
  @@map("local_ai_knowledge_documents")
}

model LocalAiProposedAction {
  id               Int                         @id @default(autoincrement())
  tenantId         Int                         @map("tenant_id")
  requesterUserId  Int                         @map("requester_user_id")
  reviewedByUserId Int?                        @map("reviewed_by_user_id")
  actionType       LocalAiProposedActionType   @map("action_type")
  status           LocalAiProposedActionStatus @default(PENDING)
  targetType       String                      @map("target_type")
  targetId         Int                         @map("target_id")
  title            String
  reason           String                      @db.Text
  riskLevel        String                      @default("low") @map("risk_level")
  requiresApproval Boolean                     @default(true) @map("requires_approval")
  executionEnabled Boolean                     @default(false) @map("execution_enabled")
  reviewNote       String?                     @map("review_note") @db.Text
  approvedAt       DateTime?                   @map("approved_at")
  rejectedAt       DateTime?                   @map("rejected_at")
  expiresAt        DateTime?                   @map("expires_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_lai_prop_tenant")
  requester  User   @relation("LocalAiProposedActionRequester", fields: [requesterUserId], references: [id], onDelete: Cascade, map: "fk_lai_prop_requester")
  reviewedBy User?  @relation("LocalAiProposedActionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull, map: "fk_lai_prop_reviewer")

  @@index([tenantId, status, createdAt], map: "idx_lai_prop_tenant_status_created")
  @@index([requesterUserId, createdAt], map: "idx_lai_prop_requester_created")
  @@index([reviewedByUserId, createdAt], map: "idx_lai_prop_reviewer_created")
  @@index([tenantId, actionType, createdAt], map: "idx_lai_prop_tenant_type_created")
  @@map("local_ai_proposed_actions")
}

// ---------------------------------------------------------------------------
// Tags de hosts
// ---------------------------------------------------------------------------

model Tag {
  id       Int       @id @default(autoincrement())
  name     String
  color    String    @default("#6b7280")
  tenantId Int       @map("tenant_id")
  hosts    HostTag[]

  @@unique([name, tenantId])
  @@map("tags")
}

model HostTag {
  hostId Int @map("host_id")
  tagId  Int @map("tag_id")

  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([hostId, tagId])
  @@index([tagId, hostId])
  @@map("host_tags")
}

model HostBulkActionHistory {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  actorUserId    Int      @map("actor_user_id")
  actionType     String   @map("action_type") @db.VarChar(40)
  actionLabel    String   @map("action_label") @db.VarChar(255)
  selectionJson  Json     @map("selection_json")
  actionJson     Json     @map("action_json")
  requested      Int
  updated        Int
  skipped        Int
  failed         Int
  resultRowsJson Json     @map("result_rows_json")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation("HostBulkActionHistoryActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt], map: "host_bulk_hist_tenant_created_idx")
  @@index([tenantId, actorUserId, createdAt], map: "host_bulk_hist_actor_created_idx")
  @@map("host_bulk_action_history")
}

// ---------------------------------------------------------------------------
// Pastas pessoais de hosts (por usuário)
// ---------------------------------------------------------------------------

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int      @map("user_id")
  tenantId  Int      @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user                User                 @relation(fields: [userId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  hosts               Host[]
  hostPersonalFolders HostPersonalFolder[]

  @@index([tenantId, userId, name], map: "folders_tenant_user_name_idx")
  @@map("folders")
}

model HostPersonalFolder {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  userId    Int      @map("user_id")
  hostId    Int      @map("host_id")
  folderId  Int      @map("folder_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, hostId], map: "host_personal_folders_tenant_user_host_uniq")
  @@index([tenantId, userId, folderId], map: "host_personal_folders_tenant_user_folder_idx")
  @@index([hostId], map: "host_personal_folders_host_idx")
  @@map("host_personal_folders")
}

// ---------------------------------------------------------------------------
// Inventario corporativo de hosts (arvore oficial do tenant)
// ---------------------------------------------------------------------------

model InventoryNode {
  id           Int               @id @default(autoincrement())
  tenantId     Int               @map("tenant_id")
  rootTenantId Int?              @unique(map: "inventory_nodes_root_tenant_key") @map("root_tenant_id")
  parentId     Int?              @map("parent_id")
  type         InventoryNodeType
  hostId       Int?              @unique(map: "inventory_nodes_host_key") @map("host_id")
  name         String            @db.VarChar(120)
  path         String            @db.VarChar(2048)
  depth        Int               @default(0)
  createdById  Int?              @map("created_by_id")
  updatedById  Int?              @map("updated_by_id")
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  tenant     Tenant             @relation("InventoryNodes", fields: [tenantId], references: [id], onDelete: Cascade, map: "inventory_nodes_tenant_id_fkey")
  rootFor    Tenant?            @relation("InventoryRoot", fields: [rootTenantId], references: [id], onDelete: Cascade, map: "inventory_nodes_root_tenant_id_fkey")
  parent     InventoryNode?     @relation("InventoryNodeChildren", fields: [parentId], references: [id], onDelete: Restrict, map: "inventory_nodes_parent_id_fkey")
  children   InventoryNode[]    @relation("InventoryNodeChildren")
  host       Host?              @relation(fields: [hostId], references: [id], onDelete: Restrict, map: "inventory_nodes_host_id_fkey")
  createdBy  User?              @relation("InventoryNodeCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "inventory_nodes_created_by_id_fkey")
  updatedBy  User?              @relation("InventoryNodeUpdater", fields: [updatedById], references: [id], onDelete: SetNull, map: "inventory_nodes_updated_by_id_fkey")
  aclEntries ResourceAclEntry[]

  @@index([tenantId, parentId, name], map: "inventory_nodes_sibling_name_idx")
  @@index([tenantId, parentId, deletedAt, name], map: "inventory_nodes_tree_idx")
  @@index([tenantId, path(length: 512)], map: "inventory_nodes_path_idx")
  @@index([tenantId, deletedAt, type, path(length: 512)], map: "inventory_nodes_tenant_deleted_type_path_idx")
  @@index([tenantId, deletedAt, depth, name, id], map: "inventory_nodes_tenant_deleted_depth_name_idx")
  @@map("inventory_nodes")
}

model ResourceAclEntry {
