
# CSP belongs to the NodeAccess app; remote web-proxy documents retain upstream policy.
map $uri $nodeaccess_csp {
  default "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs/; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs/; img-src 'self' data: blob:; font-src 'self' data: https://cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs/; connect-src 'self' https://cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs/; worker-src 'self' blob:; frame-ancestors 'self'; form-action 'self'";
  ~^/api/v1/web-access/proxy(?:/|$) "";
}
# Query strings and Referer can carry credentials; omit both from access logs.
log_format nodeaccess_safe '$remote_addr - $request_method $uri $server_protocol $status $body_bytes_sent $request_time';
access_log /var/log/nginx/access.log nodeaccess_safe;
server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;
  client_max_body_size 50m;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy $nodeaccess_csp always;

  location ^~ /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    # Nginx replaces parent add_header directives in this location.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy $nodeaccess_csp always;
    access_log off;
  }

  location = /health {
    proxy_pass http://${API_UPSTREAM}/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Tenant-Slug $host;
  }

  location ^~ /health/ {
    proxy_pass http://${API_UPSTREAM}/health/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Tenant-Slug $host;
  }

  location = /api/v1/hosts/test-connection {
    proxy_pass http://${GATEWAY_UPSTREAM}/api/v1/hosts/test-connection;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Tenant-Slug $host;
  }

  location ^~ /api/v1/tunnels {
    proxy_pass http://${GATEWAY_UPSTREAM}/api/v1/tunnels;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Tenant-Slug $host;
  }

  location ^~ /api/v1/web-access {
    proxy_pass http://${GATEWAY_UPSTREAM}/api/v1/web-access;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Tenant-Slug $host;
  }

  location /api/ {
    proxy_pass http://${API_UPSTREAM}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Tenant-Slug $host;
  }

  location /ws/ {
      # Nginx error records include the raw URL. Keep sanitized access status only.
      error_log /dev/null;
    proxy_pass http://${GATEWAY_UPSTREAM}/ws/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Tenant-Slug $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
