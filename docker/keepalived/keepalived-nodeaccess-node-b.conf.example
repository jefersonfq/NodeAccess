# NodeAccess active/passive - exemplo para no B.
# Ajuste interface, virtual_router_id, auth_pass e virtual_ipaddress.
# O no B inicia como BACKUP por prioridade menor.

global_defs {
  router_id NODEACCESS_B
  enable_script_security
  script_user root
}

vrrp_script chk_nodeaccess {
  script "/opt/nodeaccess/scripts/deploy/keepalived-health-check.sh"
  interval 5
  timeout 4
  fall 2
  rise 2
  # Sem peso, a falha coloca a instancia em FAULT e retira a VIP.
  weight 0
}

vrrp_instance VI_NODEACCESS {
  state BACKUP
  interface eth0
  virtual_router_id 51
  priority 100
  advert_int 1

  authentication {
    auth_type PASS
    auth_pass change-me
  }

  virtual_ipaddress {
    192.0.2.50/24
  }

  track_script {
    chk_nodeaccess
  }
}
