# =============================================================
# NodeAccess — Variáveis de ambiente
# =============================================================
# Copie este arquivo para .env (dev) ou .env.prod (produção)
# NUNCA commite .env ou .env.prod no repositório
#
# Legenda:
#   [obrigatório] — sem valor padrão; o servidor não sobe sem esta variável
#   [opcional]    — possui valor padrão no schema; só defina se quiser sobrescrever
#
# Gerar secrets seguros:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================


# -------------------------------------------------------------
# Aplicação
# -------------------------------------------------------------
NODE_ENV=development                   # [opcional] development | production | test
APP_MODE=api                           # [opcional] api | gateway — define qual servidor sobe
APP_PORT_API=3000                      # [opcional] porta da API REST
APP_PORT_GATEWAY=3001                  # [opcional] porta do gateway WebSocket SSH
APP_URL=http://localhost:3000          # [opcional] URL base da aplicação (sem barra final)
APP_FRONTEND_URL=http://localhost:5173 # [opcional] URL do frontend (CORS e e-mails)
TENANT_BASE_DOMAIN=                   # [opcional] domínio base para resolução de tenant por subdomínio
                                       #   Ex: nodeaccess.com.br → jeferson.nodeaccess.com.br vira slug "jeferson"
                                       #   Sem isso, o FQDN inteiro é normalizado (jeferson-nodeaccess-com-br)
TRUST_PROXY=false                      # [opcional] true quando atrás de Nginx / Cloudflare / LB

# Gateway grafico RDP/VNC
# [opcional] pending | guacd - padrao recomendado para Docker Compose: guacd
GRAPHICAL_GATEWAY_ADAPTER=guacd
# [opcional] host do guacd quando adapter=guacd
GUACD_HOST=guacd
# [opcional] porta do guacd quando adapter=guacd
GUACD_PORT=4822
# [opcional] timeout do socket/handshake com guacd
GUACD_CONNECT_TIMEOUT_MS=10000
# [opcional] formatos anunciados ao guacd. WebP tende a melhorar banda quando suportado.
GUACD_IMAGE_MIMETYPES=image/png,image/jpeg
# [opcional] manter false ate existir decoder no frontend.
GUACD_ENABLE_AUDIO_STREAMS=false
GUACD_ENABLE_VIDEO_STREAMS=false
# [opcional] defaults RDP. Em producao, prefira validar certificado e forcar NLA/TLS quando aplicavel.
GUACD_RDP_SECURITY=any
GUACD_RDP_IGNORE_CERT=true
GUACD_RDP_RESIZE_METHOD=reconnect
GUACD_RDP_COLOR_DEPTH=24
GUACD_RDP_FORCE_LOSSLESS=true
GUACD_RDP_SERVER_LAYOUT=pt-br-qwerty
GUACD_RDP_ENABLE_WALLPAPER=false
GUACD_RDP_ENABLE_THEMING=false
GUACD_RDP_ENABLE_FONT_SMOOTHING=true
GUACD_RDP_ENABLE_FULL_WINDOW_DRAG=false
GUACD_RDP_ENABLE_DESKTOP_COMPOSITION=false
GUACD_RDP_ENABLE_MENU_ANIMATIONS=false
GUACD_RDP_DISABLE_GFX=true
GUACD_RDP_DISABLE_BITMAP_CACHING=true
GUACD_RDP_DISABLE_OFFSCREEN_CACHING=true
# [opcional] defaults VNC.
GUACD_VNC_COLOR_DEPTH=24
GUACD_VNC_READ_ONLY=false
GUACD_VNC_SWAP_RED_BLUE=false
GUACD_VNC_CURSOR=remote


# -------------------------------------------------------------
# Banco de dados — MySQL 8.0
# -------------------------------------------------------------
# Variáveis abaixo são usadas pelo Docker Compose para criar o container.
# DATABASE_URL deve refletir os mesmos valores.
DB_ROOT_PASSWORD=troque-em-producao   # [opcional para Docker Compose]
DB_NAME=sshplatform                   # [opcional para Docker Compose]
DB_USER=sshapp                        # [opcional para Docker Compose]
DB_PASSWORD=troque-em-producao        # [opcional para Docker Compose]

DATABASE_URL=mysql://sshapp:troque-em-producao@localhost:3306/sshplatform  # [obrigatório]
PRISMA_LOG_QUERIES=false              # [opcional] true exibe todas as queries SQL no log


# -------------------------------------------------------------
# Redis
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379      # [obrigatório]
REDIS_PASSWORD=                       # [opcional] vazio em dev; obrigatório em prod com auth


# -------------------------------------------------------------
# JWT
# -------------------------------------------------------------
# JWT_SECRET: mínimo 32 chars — gerar com crypto.randomBytes(32).toString('hex')
JWT_SECRET=cole-aqui-string-aleatoria-de-64-chars  # [obrigatório]
JWT_EXPIRES_IN=15m                    # [opcional] duração do access token  — padrão: 15m
JWT_REFRESH_EXPIRES_IN=7d             # [opcional] duração do refresh token — padrão: 7d


# -------------------------------------------------------------
# Criptografia AES-256-GCM
# Usada para: chaves PEM, senhas SSH, credenciais SMTP e secrets do vault
# Deve ter exatamente 64 caracteres hexadecimais (= 32 bytes)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -------------------------------------------------------------
PEM_ENCRYPTION_KEY=cole-aqui-64-chars-hex  # [obrigatório]


# -------------------------------------------------------------
# Autenticação — TOTP / MFA
# -------------------------------------------------------------
TOTP_ISSUER=NodeAccess                # [opcional] nome exibido no app autenticador — padrão: SSH Web Platform


# -------------------------------------------------------------
# Política de senhas
# Validada por regex no backend e no frontend simultaneamente
#
# Exemplos de regex:
#   Simples (só tamanho):      ^.{8,}$
#   Média (maiúscula+número):  ^(?=.*[A-Z])(?=.*\d).{8,}$
#   Forte (+ símbolo):         ^(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}$
# -------------------------------------------------------------
PASSWORD_MIN_LENGTH=8                 # [opcional] padrão: 8
PASSWORD_POLICY_REGEX=^(?=.*[A-Z])(?=.*\d).{8,}$  # [opcional]
PASSWORD_POLICY_DESCRIPTION=Mínimo 8 caracteres, 1 maiúscula e 1 número  # [opcional]


# -------------------------------------------------------------
# Licença e limites de sessão
# -------------------------------------------------------------
LICENSE_MAX_USERS=300                 # [opcional] limite de usuários ativos — padrão: 300
LICENSE_KEY=                          # [opcional] chave de licença (vazio = modo community)
LICENSE_MULTI_CONNECT=false           # [opcional] permite múltiplas sessões simultâneas por usuário

SESSION_MAX_ACTIVE_PER_USER=          # [opcional] limite de sessões SSH por usuário (vazio = ilimitado)
SESSION_MAX_ACTIVE_PER_TENANT=        # [opcional] limite de sessões SSH por tenant (vazio = ilimitado)


# -------------------------------------------------------------
# Auditoria de sessão SSH
# -------------------------------------------------------------
FEATURE_SESSION_AUDIT=false           # [opcional] habilita gravação de sessões — padrão: false
FEATURE_SESSION_AUDIT_AI_SUMMARY=false         # [opcional] resumo por IA ao encerrar sessão — padrão: false
FEATURE_SESSION_AUDIT_AI_AUTO_SUMMARY=false    # [opcional] resumo automático sem ação manual — padrão: false
FEATURE_SESSION_AUDIT_GUARDRAILS=false         # [opcional] bloqueio por padrão de comando — padrão: false
FEATURE_SESSION_AUDIT_TICKET_CONTEXT=false     # [opcional] exige ticket ao iniciar sessão auditada — padrão: false
FEATURE_SESSION_AUDIT_TICKET_WRITEBACK=false   # [opcional] registra acesso de volta no ticket — padrão: false

SESSION_AUDIT_STORAGE_DIR=./data/session-audit  # [opcional] diretório de chunks — padrão: /tmp/nodeaccess-session-audit
SESSION_AUDIT_CHUNK_MAX_BYTES=65536             # [opcional] tamanho máximo por chunk em bytes — padrão: 131072
SESSION_AUDIT_POLICY_CACHE_TTL_SECONDS=30       # [opcional] TTL do cache de políticas em segundos — padrão: 30

# Worker de IA para resumo assíncrono
SESSION_AUDIT_AI_REQUEST_TIMEOUT_MS=120000      # [opcional] timeout por requisição de resumo — padrão: 120000
SESSION_AUDIT_AI_JOB_STALE_MS=300000            # [opcional] tempo para considerar job travado — padrão: 300000
SESSION_AUDIT_AI_WORKER_POLL_MS=15000           # [opcional] intervalo de polling do worker — padrão: 15000
SESSION_AUDIT_AI_WORKER_INITIAL_DELAY_MS=10000  # [opcional] delay inicial antes do primeiro poll — padrão: 10000


# -------------------------------------------------------------
# IA local (opcional)
# -------------------------------------------------------------
FEATURE_LOCAL_AI=false                # [opcional] habilita modelo de IA local (Ollama etc.) — padrão: false


# -------------------------------------------------------------
# MCP — Model Context Protocol
# Interface governada para expor contexto e tools a assistentes de IA
# -------------------------------------------------------------
FEATURE_MCP=false                     # [opcional] habilita o servidor MCP — padrão: false

MCP_STATIC_TOKEN=                     # [opcional] Bearer token para autenticação no MCP
MCP_STATIC_TENANT_SLUG=               # [opcional] tenant associado ao token estático acima
# Capacidades habilitadas para o token (separadas por vírgula)
# Exemplo: read,action_run,ssh_session
MCP_ALLOWED_CAPABILITIES=

# Rate limit do MCP
MCP_RATE_LIMIT_WINDOW_SECONDS=60      # [opcional] janela de contagem de requisições — padrão: 60
MCP_RATE_LIMIT_MAX_REQUESTS=120       # [opcional] máximo de requisições por janela — padrão: 120

# Sessões SSH interativas via MCP
MCP_INTERACTIVE_SSH_DEFAULT_TTL_SECONDS=900       # [opcional] TTL padrão de sessão SSH — padrão: 900 (15 min)
MCP_INTERACTIVE_SSH_MAX_TTL_SECONDS=3600          # [opcional] TTL máximo permitido — padrão: 3600 (1 hora)
MCP_INTERACTIVE_SSH_MAX_SESSIONS_PER_TOKEN=3      # [opcional] sessões abertas por token MCP — padrão: 3
MCP_INTERACTIVE_SSH_MAX_SESSIONS_PER_TENANT=20    # [opcional] sessões abertas por tenant — padrão: 20
MCP_INTERACTIVE_SSH_REQUIRE_ALLOWED_HOSTS=false   # [opcional] restringe a hosts da allowlist — padrão: false


# -------------------------------------------------------------
# IA — Padrões de comandos SSH operacional
# Expressões regulares separadas por vírgula; vazio = usar defaults do sistema
# -------------------------------------------------------------
AI_SSH_ACTION_SAFE_COMMAND_PATTERNS=              # [opcional] comandos sempre permitidos sem confirmação
AI_SSH_ACTION_APPROVAL_COMMAND_PATTERNS=          # [opcional] comandos que exigem aprovação explícita
AI_SSH_ACTION_BLOCKED_COMMAND_PATTERNS=           # [opcional] comandos completamente bloqueados


# -------------------------------------------------------------
# Google SSO e Directory Sync
# Configuração principal fica na integração Google salva no banco por tenant.
# Estas variáveis são o fallback legado — manter vazio para evitar ambiguidade.
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=                     # [opcional]
GOOGLE_CLIENT_SECRET=                 # [opcional]
GOOGLE_CALLBACK_URL=http://localhost/auth/google/callback  # [opcional]

# OIDC corporativo: capacidades globais; o tenant ainda precisa habilitar sua política.
AUTH_OIDC_ALLOW_JIT=false
AUTH_OIDC_ALLOW_AUTOMATIC_LINKING=false
AUTH_ALLOW_EMAIL_TENANT_DISCOVERY=true

GOOGLE_DIRECTORY_SYNC_INTERVAL_MS=3600000        # [opcional] intervalo entre syncs — padrão: 3600000 (1 hora)
GOOGLE_DIRECTORY_SYNC_INITIAL_DELAY_MS=30000     # [opcional] delay inicial após subir o servidor — padrão: 30000


# -------------------------------------------------------------
# Métricas (Prometheus)
# -------------------------------------------------------------
FEATURE_METRICS=false                 # [opcional] habilita endpoint /metrics — padrão: false
METRICS_TOKEN=                        # [opcional] Bearer token para proteger o endpoint de métricas


# -------------------------------------------------------------
# Frontend (Vite)
# Prefixo VITE_ expõe a variável para o código do browser
# -------------------------------------------------------------
VITE_API_URL=http://localhost/api/v1  # [opcional] URL base da API consumida pelo frontend
VITE_WS_URL=ws://localhost/ws         # [opcional] URL base do WebSocket SSH
