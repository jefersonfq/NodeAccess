# -------------------------------------------------------------
# Política de senhas (validada por regex no backend e frontend)
# Padrão: mínimo 8 chars, 1 maiúscula, 1 número
# Exemplos:
#   Simples (só tamanho):      ^.{8,}$
#   Média (maiúscula+número):  ^(?=.*[A-Z])(?=.*\d).{8,}$
#   Forte (+ símbolo):         ^(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}$
# -------------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_POLICY_REGEX=^(?=.*[A-Z])(?=.*\d).{8,}$
PASSWORD_POLICY_DESCRIPTION=Mínimo 8 caracteres, 1 maiúscula e 1 número

# -------------------------------------------------------------
# App
# -------------------------------------------------------------
# Copie este arquivo para .env (dev) ou .env.prod (produção)
# NUNCA commite .env ou .env.prod no repositório
# =============================================================

# App
NODE_ENV=development
APP_MODE=api                           # 'api' ou 'gateway' — altera qual servidor sobe
APP_PORT_API=3000
APP_PORT_GATEWAY=3001
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------
# Banco de dados — MySQL 8.0
# -------------------------------------------------------------
DB_ROOT_PASSWORD=troque-em-producao
DB_NAME=sshplatform
DB_USER=sshapp
DB_PASSWORD=troque-em-producao

# Prisma usa esta URL diretamente
DATABASE_URL=mysql://sshapp:troque-em-producao@mysql:3306/sshplatform
PRISMA_LOG_QUERIES=false

# -------------------------------------------------------------
# Redis
# -------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=                        # deixar vazio em dev, obrigatório em prod

# -------------------------------------------------------------
# JWT
# -------------------------------------------------------------
JWT_SECRET=troque-por-string-aleatoria-de-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------------
# Criptografia AES-256-GCM (chaves PEM e senhas SSH)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -------------------------------------------------------------
PEM_ENCRYPTION_KEY=cole-aqui-64-chars-hex

# -------------------------------------------------------------
# 2FA (TOTP)
# -------------------------------------------------------------
TOTP_ISSUER=SSH Web Platform

# -------------------------------------------------------------
# Google SSO (legado / atualmente a configuracao principal fica
# na integracao Google salva no banco)
# Manter comentado por enquanto para evitar ambiguidade.
# -------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost/auth/google/callback

# -------------------------------------------------------------
# Licença
# -------------------------------------------------------------
LICENSE_MAX_USERS=300
LICENSE_KEY=
LICENSE_MULTI_CONNECT=false
SESSION_MAX_ACTIVE_PER_USER=
SESSION_MAX_ACTIVE_PER_TENANT=

# -------------------------------------------------------------
# Session audit
# -------------------------------------------------------------
FEATURE_SESSION_AUDIT=false
FEATURE_SESSION_AUDIT_AI_SUMMARY=false
FEATURE_SESSION_AUDIT_GUARDRAILS=false
FEATURE_SESSION_AUDIT_TICKET_CONTEXT=false
FEATURE_SESSION_AUDIT_TICKET_WRITEBACK=false
SESSION_AUDIT_STORAGE_DIR=/tmp/nodeaccess-session-audit
SESSION_AUDIT_CHUNK_MAX_BYTES=131072
SESSION_AUDIT_AI_WORKER_POLL_MS=15000
SESSION_AUDIT_AI_WORKER_INITIAL_DELAY_MS=10000
GOOGLE_DIRECTORY_SYNC_INTERVAL_MS=3600000
GOOGLE_DIRECTORY_SYNC_INITIAL_DELAY_MS=30000

# -------------------------------------------------------------
# Frontend (Vite — prefixo VITE_ expõe para o browser)
# -------------------------------------------------------------
VITE_API_URL=http://localhost/api/v1
VITE_WS_URL=ws://localhost/ws
