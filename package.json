{
  "name": "nodeaccess",
  "version": "0.1.0",
  "private": true,
  "description": "NodeAccess — SSH web platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:clean && npm run dev:raw",
    "dev:raw": "concurrently --names api,gateway,frontend,warmup --prefix-colors blue,magenta,cyan,gray \"npm run dev -w apps/backend\" \"npm run dev:gateway -w apps/backend\" \"bash scripts/dev-frontend.sh\" \"wait-on tcp:3000 tcp:5173 && npm run dev:warmup\"",
    "dev:clean": "bash scripts/dev-clean.sh",
    "dev:warmup": "node tools/frontend/dev-warmup.cjs",
    "test:dev-warmup": "node --test tools/frontend/dev-warmup.test.cjs",
    "test:hosts-browser-cache": "node --test tools/frontend/hosts-browser-cache.test.cjs",
    "harness:hosts-browser-cache": "node tools/frontend/hosts-browser-cache-harness.cjs",
    "lint": "eslint apps/backend/src apps/frontend/src --ext .ts,.vue --max-warnings 0",
    "lint:changed": "node scripts/lint-changed.mjs",
    "typecheck": "npm run build -w packages/shared && npm run typecheck -w apps/backend && npm run typecheck -w apps/frontend",
    "test": "vitest run --reporter=verbose",
    "test:change-governance": "node --test scripts/change-governance.test.mjs",
    "test:change-status": "node --test scripts/change-status.test.mjs",
    "status:change": "node scripts/change-status.mjs",
    "validate:change": "node scripts/change-governance.mjs",
    "test:ha:web": "node tools/frontend/ha-playwright-smoke.cjs",
    "test:ha:web:live": "node tools/frontend/ha-playwright-live-readonly.cjs",
    "test:session-command-policies:web": "node tools/frontend/session-command-policies-playwright.cjs",
    "test:terminal-experience:web": "node tools/frontend/terminal-experience-playwright.cjs",
    "test:sharing-flows:web": "node tools/frontend/sharing-flows-playwright.cjs",
    "test:agent-faults": "node --test tools/agent/faults.test.cjs",
    "test:acl:core": "vitest run apps/frontend/src/services/api-public-auth.test.ts apps/backend/src/modules/inventory/inventory-acl.routes.test.ts apps/backend/src/modules/hosts/host.service.test.ts apps/backend/src/modules/inventory/inventory-acl.service.test.ts apps/backend/src/modules/inventory/inventory.service.test.ts apps/backend/src/modules/inventory/inventory-acl-session-revocation.service.test.ts apps/backend/src/modules/ssh/ssh.repository-acl.test.ts",
    "test:acl:mysql": "RUN_ACL_MYSQL=true vitest run apps/backend/src/modules/inventory/inventory-acl.mysql.test.ts",
    "test:acl:web": "node tools/frontend/hosts-acl-resilience-playwright.cjs && ACL_TARGET=host node tools/frontend/hosts-acl-resilience-playwright.cjs && node tools/frontend/hosts-corporate-folders-playwright.cjs",
    "test:forwardings:core": "vitest run apps/backend/src/modules/tunnels/tunnel-runtime.registry.test.ts apps/frontend/src/services/tunnel-presence.test.ts apps/backend/src/modules/tunnels/tunnel-concurrency.test.ts apps/backend/src/modules/port-forwardings/port-forwarding.service.test.ts apps/frontend/src/services/api-public-auth.test.ts",
    "test:forwardings:redis:real": "RUN_TUNNEL_REDIS_REAL=true vitest run apps/backend/src/modules/tunnels/tunnel-runtime.real.test.ts",
    "test:forwardings:real": "RUN_TUNNEL_REAL=true vitest run apps/backend/src/modules/tunnels/tunnel-real.test.ts",
    "test:forwardings:web": "node tools/frontend/forwardings-resilience-playwright.cjs",
    "test:webhooks:core": "vitest run apps/backend/src/modules/inbound-webhooks/inbound-webhook.routes.test.ts apps/backend/src/modules/inbound-webhooks/inbound-webhook.repository.test.ts apps/backend/src/modules/inbound-webhooks/inbound-webhook.service.test.ts apps/backend/src/modules/webhooks/webhook-dispatcher.service.test.ts apps/frontend/src/services/api-public-auth.test.ts",
    "test:webhooks:web": "node tools/frontend/webhooks-resilience-playwright.cjs",
    "test:presence:core": "vitest run apps/backend/src/modules/sessions/sessions.service.test.ts apps/backend/src/modules/sessions/sessions.repository.test.ts apps/backend/src/modules/sessions/session-runtime-control.bus.test.ts apps/frontend/src/services/session-presence-projection.test.ts",
    "test:presence:web": "node tools/frontend/hosts-presence-resilience-playwright.cjs",
    "test:resilience:core": "npm run test:agent-faults && vitest run apps/backend/src/modules/sessions/sessions.service.test.ts apps/frontend/src/services/session-presence-projection.test.ts apps/frontend/src/services/api-public-auth.test.ts",
    "test:resilience:web": "npm run test:sharing-flows:web && npm run test:terminal-experience:web",
    "test:terminal-pty:real": "bash tools/frontend/terminal-pty-real-certification.sh",
    "test:terminal-experience:light:web": "UI_THEME=light node tools/frontend/terminal-experience-playwright.cjs",
    "test:terminal-split-layout:web": "node tools/frontend/terminal-split-layout-playwright.cjs",
    "test:snippets:web": "node tools/frontend/snippets-page-playwright.cjs",
    "test:hosts-personal-folders:web": "node tools/frontend/hosts-personal-folders-playwright.cjs",
    "test:hosts-corporate-folders:web": "node tools/frontend/hosts-corporate-folders-playwright.cjs",
    "test:host-secret-credentials:web": "node tools/frontend/host-secret-credentials-playwright.cjs",
    "test:host-shortcuts:web": "node tools/frontend/host-shortcut-navigation-playwright.cjs",
    "test:secrets:core": "vitest run apps/backend/src/modules/secrets/secret.service.test.ts apps/backend/src/modules/secrets/secret.repository.test.ts",
    "test:secrets-vault:web": "node tools/frontend/secrets-vault-playwright.cjs",
    "test:secret-ssh:real": "RUN_SECRET_SSH_REAL=true vitest run apps/backend/src/modules/secrets/secret-ssh.integration.test.ts",
    "test:native-ssh-gateway:web": "node tools/frontend/native-ssh-gateway-playwright.cjs",
    "test:hosts-personal-folders:light:web": "UI_THEME=light node tools/frontend/hosts-personal-folders-playwright.cjs",
    "test:mobaxterm-import:web": "node tools/frontend/mobaxterm-import-playwright.cjs",
    "test:host-import:resilience:web": "node tools/frontend/host-import-resilience-playwright.cjs",
    "test:host-import:live": "RUN_HOST_IMPORT_LIVE=true node tools/frontend/host-import-live.cjs",
    "test:host-import:core": "vitest run apps/frontend/src/services/api-public-auth.test.ts apps/backend/src/modules/host-imports/host-import.service.test.ts apps/backend/src/modules/host-imports/host-import.routes.test.ts apps/frontend/src/services/mobaxterm-import.service.test.ts apps/frontend/src/services/import-sessions-preview.service.test.ts",
    "test:host-import-duplicates:web": "node tools/frontend/host-import-duplicates-playwright.cjs",
    "test:theme-light:web": "UI_THEME=light node tools/frontend/mobaxterm-import-playwright.cjs",
    "test:sessions-filters:web": "node tools/frontend/sessions-filters-playwright.cjs",
    "test:sftp:web": "node tools/frontend/sftp-file-manager-harness.cjs",
    "test:session-playback:web": "node tools/frontend/session-playback-playwright.cjs",
    "test:session-playback:visual": "PLAYBACK_VISUAL_ARTIFACTS=1 node tools/frontend/session-playback-playwright.cjs",
    "test:session-playback:cdp": "bash tools/frontend/session-playback-cdp-harness.sh",
    "test:session-audit:core": "vitest run apps/backend/src/modules/session-audit/session-audit-normalizer.test.ts apps/backend/src/modules/session-audit/session-audit.publisher.test.ts",
    "test:action-run-audit:web": "node tools/frontend/action-run-audit-playwright.cjs",
    "test:ai-investigations:web": "node tools/frontend/ai-investigations-playwright.cjs",
    "test:action-run-audit": "vitest run apps/backend/src/modules/ai-ssh-actions/ai-ssh-action-audit.service.test.ts apps/backend/src/modules/ai-ssh-actions/ai-ssh-action-governance.test.ts apps/backend/src/modules/session-audit/session-audit-normalizer.test.ts apps/backend/src/modules/session-audit/session-audit.publisher.test.ts && npm run test:action-run-audit:web",
    "test:pem-key-passphrase:web": "node tools/frontend/pem-key-passphrase-playwright.cjs",
    "test:oidc-login:web": "node tools/frontend/oidc-login-playwright.cjs",
    "test:oidc-admin:web": "node tools/frontend/oidc-admin-playwright.cjs",
    "test:jira-integration:web": "node tools/frontend/jira-integration-playwright.cjs",
    "test:platform-settings:web": "node tools/frontend/platform-settings-playwright.cjs",
    "test:cache-settings:web": "node tools/frontend/cache-settings-playwright.cjs",
    "test:cache-settings:cdp": "bash tools/frontend/cache-settings-cdp-harness.sh",
    "test:host-backed-bastions:web": "node tools/frontend/host-backed-bastions-playwright.cjs",
    "test:local-ai:web": "node tools/frontend/local-ai-playwright.cjs",
    "test:mcp-agent-onboarding:web": "node tools/frontend/mcp-agent-onboarding-playwright.cjs",
    "test:network-feedback:core": "vitest run apps/backend/src/modules/shared-sessions/shared-session-reuse.test.ts apps/frontend/src/services/backend-recovery.service.test.ts",
    "test:network-feedback:web": "node tools/frontend/hosts-feedback-ux-playwright.cjs && node tools/frontend/terminal-experience-playwright.cjs",
    "test:lucien-feedback:ux": "node tools/frontend/lucien-feedback-ux-playwright.cjs && node tools/frontend/hosts-feedback-ux-playwright.cjs",
    "test:lucien-feedback:core": "vitest run apps/backend/src/modules/session-supervision/session-supervision.service.test.ts apps/backend/src/modules/agents/agent-local-listener.test.ts apps/backend/src/modules/agents/agent-operations.test.ts apps/backend/src/modules/agents/agent-service-operations.test.ts apps/backend/src/modules/tags/tag.service.test.ts apps/frontend/src/services/api-sftp-recovery.test.ts",
    "test:agents:web": "node tools/frontend/agents-experience-playwright.cjs",
    "test:agents:cdp": "bash tools/frontend/agents-experience-cdp-harness.sh",
    "test:user-dashboard:web": "node tools/frontend/user-dashboard-playwright.cjs",
    "test:critical-ux-focus:web": "node tools/frontend/critical-ux-focus-playwright.cjs",
    "test:mcp-codex-governance": "node tools/mcp/codex-governance-harness.cjs",
    "test:ai-ssh:web": "node tools/frontend/real-ai-ssh-playwright.cjs",
    "test:oidc:keycloak": "bash tools/oidc/keycloak-certification-harness.sh",
    "test:oidc:entra:metadata": "npx tsx tools/oidc/entra-metadata-certification.ts",
    "test:oidc:okta:metadata": "npx tsx tools/oidc/okta-metadata-certification.ts",
    "test:oidc:compatibility": "vitest run apps/backend/src/modules/auth/oidc.service.test.ts apps/backend/src/modules/auth/oidc-provider-compatibility.test.ts apps/backend/src/modules/auth/oidc-flow.service.test.ts",
    "test:scim:compatibility": "vitest run apps/backend/src/modules/auth/scim.service.test.ts apps/backend/src/modules/auth/scim.routes.test.ts",
    "test:helm-chart": "node tools/deploy/helm-chart-harness.cjs",
    "test:helm-gateway-drain": "bash tools/deploy/helm-gateway-drain-harness.sh",
    "test:helm-ingress-wss": "node tools/deploy/helm-ingress-wss-client.cjs",
    "test:helm-kind-certification": "bash tools/deploy/helm-kind-certification-harness.sh",
    "test:helm-ollama-certification": "bash tools/deploy/helm-ollama-kind-certification.sh",
    "test:helm-upgrade-rollback-secret": "bash tools/deploy/helm-upgrade-rollback-secret-harness.sh",
    "test:na-0015:core": "vitest run apps/backend/src/modules/auth/auth-policy.test.ts apps/backend/src/modules/auth/auth.service.ldap.test.ts apps/backend/src/modules/auth/auth.service.refresh.test.ts apps/backend/src/modules/auth/auth.service.temp-token.test.ts apps/backend/src/modules/auth/auth.service.token-lifetime.test.ts apps/backend/src/modules/auth/tenant-auth-policy.service.test.ts apps/backend/src/modules/auth/tenant-auth-policy.routes.test.ts apps/backend/src/modules/auth/oidc.service.test.ts apps/backend/src/modules/auth/oidc-config.service.test.ts apps/backend/src/modules/auth/oidc-flow.service.test.ts apps/backend/src/modules/auth/external-identity.repository.test.ts apps/backend/src/modules/auth/external-identity.service.test.ts apps/backend/src/modules/auth/oidc-auth.service.test.ts apps/backend/src/modules/auth/oidc-auth.routes.test.ts apps/backend/src/modules/auth/oidc-config.routes.test.ts --reporter=verbose && npm run test:helm-chart",
    "test:ha:agent-install": "bash tools/deploy/install-ha-agent-harness.sh",
    "test:ha:promotion-plan": "bash tools/deploy/ha-promotion-plan-harness.sh",
    "test:ha:mysql-rejoin": "bash tools/deploy/mysql-ha-rejoin-harness.sh",
    "test:ha:prepare-rejoin": "bash tools/deploy/prepare-ha-rejoin-harness.sh",
    "test:ha:reconcile-gtids": "bash tools/deploy/reconcile-ha-empty-gtids-harness.sh",
    "test:ha:quiesce-primary": "bash tools/deploy/quiesce-ha-primary-harness.sh",
    "test:ha:switchover-barrier": "bash tools/deploy/ha-switchover-barrier-harness.sh",
    "test:ha:auto-failover": "bash tools/deploy/ha-auto-failover-harness.sh",
    "test:ha:witness": "node tools/deploy/ha-fencing-service-harness.mjs",
    "test:ha:witness-authorizer": "bash tools/deploy/ha-witness-authorizer-harness.sh",
    "test:ha:control-plane": "npm run test:ha:agent-install && npm run test:ha:promotion-plan && npm run test:ha:prepare-rejoin && npm run test:ha:reconcile-gtids && npm run test:ha:quiesce-primary && npm run test:ha:switchover-barrier && npm run test:ha:auto-failover && npm run test:ha:witness && npm run test:ha:witness-authorizer",
    "test:ha:lifecycle": "npm run test:ha:control-plane && bash tools/deploy/manual-failover-harness.sh && RUN_HA_REJOIN_HARNESS=true npm run test:ha:mysql-rejoin",
    "test:rdp:first-paint": "node tools/rdp/rdp-first-paint-check.cjs",
    "test:watch": "vitest --reporter=verbose",
    "test:cov": "vitest run --coverage",
    "build": "npm run build -w packages/shared && npm run build -w apps/backend && npm run build -w apps/frontend",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "db:status": "npm run db:status -w apps/backend",
    "db:deploy": "npm run db:deploy -w apps/backend",
    "db:studio": "npm run db:studio -w apps/backend",
    "db:seed": "npm run db:seed -w apps/backend",
    "docs": "typedoc --entryPointStrategy packages --out docs",
    "test:network-access:lab": "RUN_NETWORK_ACCESS_LIVE=true RUN_NETWORK_DEVICE_EMULATION=true node --env-file=apps/backend/.env --import tsx tools/network-access/live.mjs",
    "test:network-access:soak": "RUN_NETWORK_ACCESS_LIVE=true RUN_NETWORK_DEVICE_EMULATION=true RUN_NETWORK_ACCESS_SOAK=true node --env-file=apps/backend/.env --import tsx tools/network-access/live.mjs",
    "test:network-access": "vitest run apps/backend/src/modules/network-access apps/backend/src/modules/hosts/host.routes-profile.test.ts apps/backend/src/modules/hosts/host.service.test.ts apps/backend/src/modules/sftp/sftp.service.test.ts apps/backend/src/modules/ssh/ssh.repository-bastion-source.test.ts apps/frontend/src/stores/terminals.test.ts apps/frontend/src/services/api-public-auth.test.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^1.5.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "playwright": "^1.61.1",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5",
    "vitest": "^1.5.2",
    "wait-on": "^9.0.4"
  }
}
