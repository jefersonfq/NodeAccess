{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "api", "gateway"],
  "properties": {
    "existingSecret": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "api": { "$ref": "#/definitions/workload" },
    "gateway": { "$ref": "#/definitions/workload" },
    "frontend": {
      "type": "object",
      "required": ["enabled", "image", "replicas", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "apiPaths": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
        "gatewayPaths": { "type": "array", "items": { "type": "string", "pattern": "^/" } }
      }
    },
    "tests": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 }
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["serviceMonitor", "prometheusRule"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "required": ["enabled", "interval", "scrapeTimeout", "metricsTokenSecretKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
            "scrapeTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
            "metricsTokenSecretKey": { "type": "string", "minLength": 1 },
            "additionalLabels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "prometheusRule": {
          "type": "object",
          "required": ["enabled", "discoveryFailures", "tokenValidationFailures", "loginErrors"],
          "properties": {
            "enabled": { "type": "boolean" },
            "additionalLabels": { "type": "object", "additionalProperties": { "type": "string" } },
            "discoveryFailures": { "$ref": "#/definitions/alertRule" },
            "tokenValidationFailures": { "$ref": "#/definitions/alertRule" },
            "loginErrors": { "$ref": "#/definitions/alertRule" }
          }
        }
      }
    }
  },
  "definitions": {
    "alertRule": {
      "type": "object",
      "required": ["window", "threshold", "for"],
      "properties": {
        "window": { "type": "string", "pattern": "^[1-9][0-9]*(s|m|h|d)$" },
        "threshold": { "type": "integer", "minimum": 1 },
        "for": { "type": "string", "pattern": "^[1-9][0-9]*(s|m|h|d)$" }
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicas", "port"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
