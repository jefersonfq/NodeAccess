NODE_ENV=production

# Runtime
APP_URL=https://nodeaccess.example.com
APP_FRONTEND_URL=https://nodeaccess.example.com
APP_PORT_API=3000
APP_PORT_GATEWAY=3001
TRUST_PROXY=true
TLS_MODE=provided
# Valores aceitos: off | provided | selfsigned
# O compose usa a config de Nginx resolvida pelos scripts de deploy.

# Graphical gateway RDP/VNC
GRAPHICAL_GATEWAY_ADAPTER=guacd
GUACD_HOST=guacd
GUACD_PORT=4822
GUACD_CONNECT_TIMEOUT_MS=10000
GUACD_IMAGE_MIMETYPES=image/png,image/jpeg
GUACD_ENABLE_AUDIO_STREAMS=false
GUACD_ENABLE_VIDEO_STREAMS=false
GUACD_RDP_SECURITY=any
GUACD_RDP_IGNORE_CERT=true
GUACD_RDP_RESIZE_METHOD=reconnect
GUACD_RDP_COLOR_DEPTH=24
GUACD_RDP_FORCE_LOSSLESS=true
GUACD_RDP_SERVER_LAYOUT=pt-br-qwerty
GUACD_RDP_ENABLE_WALLPAPER=false
GUACD_RDP_ENABLE_THEMING=false
GUACD_RDP_ENABLE_FONT_SMOOTHING=true
GUACD_RDP_ENABLE_FULL_WINDOW_DRAG=false
GUACD_RDP_ENABLE_DESKTOP_COMPOSITION=false
GUACD_RDP_ENABLE_MENU_ANIMATIONS=false
GUACD_RDP_DISABLE_GFX=true
GUACD_RDP_DISABLE_BITMAP_CACHING=true
GUACD_RDP_DISABLE_OFFSCREEN_CACHING=true
GUACD_VNC_COLOR_DEPTH=24
GUACD_VNC_READ_ONLY=false
GUACD_VNC_SWAP_RED_BLUE=false
GUACD_VNC_CURSOR=remote

# Database
DB_ROOT_PASSWORD=change_this_root_password
DB_NAME=nodeaccess
DB_USER=nodeaccess_app
DB_PASSWORD=change_this_app_password
DATABASE_URL=mysql://nodeaccess_app:change_this_app_password@mysql:3306/nodeaccess

# Redis
REDIS_URL=redis://redis:6379

# HA com dependencias externas (usar com docker-compose.ha.yml)
# USE_EXTERNAL_STATEFUL_SERVICES=true
# DB_HOST=mysql-ha.example.com
# DB_PORT=3306
# DATABASE_URL=mysql://nodeaccess_app:change_this_app_password@mysql-ha.example.com:3306/nodeaccess
# REDIS_URL=redis://redis-ha.example.com:6379
# SESSION_AUDIT_HOST_DIR=/mnt/nodeaccess/session-audit
# USER_AVATAR_HOST_DIR=/mnt/nodeaccess/user-avatars
# POC com estado central no no A (usar apenas com docker-compose.ha-state.yml):
# MYSQL_BIND_ADDRESS=192.168.1.100
# MYSQL_PUBLISHED_PORT=3307
# REDIS_BIND_ADDRESS=192.168.1.100
# REDIS_PUBLISHED_PORT=6380

# Security
# Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_strong_secret_at_least_32_chars

# Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: para restaurar um banco existente, mantenha exatamente a mesma chave.
PEM_ENCRYPTION_KEY=replace_with_64_hex_chars

# Auth / MFA
TOTP_ISSUER=NodeAccess

# Licensing
LICENSE_MAX_USERS=300
LICENSE_MULTI_CONNECT=false

# Optional features
FEATURE_METRICS=false
FEATURE_MCP=false
FEATURE_SESSION_AUDIT=false
FEATURE_SESSION_AUDIT_AI_SUMMARY=false
FEATURE_SESSION_AUDIT_AI_AUTO_SUMMARY=false
FEATURE_LOCAL_AI=false
FEATURE_SESSION_AUDIT_GUARDRAILS=false
FEATURE_SESSION_AUDIT_TICKET_CONTEXT=false
FEATURE_SESSION_AUDIT_TICKET_WRITEBACK=false

# Optional integrations
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
